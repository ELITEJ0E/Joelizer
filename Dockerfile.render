# Dedicated persistent Remotion/FFmpeg backend for frame-accurate exports.
# Build: docker build -f Dockerfile.render -t joelizer-render .
FROM node:22-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    ffmpeg ca-certificates libnss3 libatk-bridge2.0-0 libx11-xcb1 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libasound2 \
    libgbm1 libgtk-3-0 libxkbcommon0 libpango-1.0-0 libdrm2 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json ./
RUN npm install --no-package-lock --no-audit --no-fund
COPY . .
RUN npm run build

ENV NODE_ENV=production
ENV PORT=3000
ENV RENDER_DATA_DIR=/data
RUN mkdir -p /data/staged /data/exports
EXPOSE 3000
CMD ["npm", "start"]
